# Origin of the UroApp backend.
#
# Local dev: leave unset. Vite proxies /api to localhost:3002 (see vite.config.js).
#
# Deployed: only needed if the backend is NOT at the default
# https://uroapp-backend.onrender.com — production builds fall back to that.
# The static site has no proxy, so a wrong value here means every /api request
# is answered with HTML and the app reports that it can't reach the server.
#
# Set to "/" if your host rewrites /api to the backend itself.
VITE_API_BASE=https://uroapp-backend.onrender.com
