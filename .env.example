# UroApp build-time settings. Copy to .env.local for local development.
# Every VITE_* value is compiled into the app bundle — never put a secret here.

# Optional accounts + cloud backup (Supabase → Project Settings → API).
# Leave both unset and the app has no account UI and makes no account requests.
# Use the publishable/anon key only — NEVER the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Subscriptions (RevenueCat → Project → API keys → the public iOS key, starts appl_).
# Pro/Elite gating needs BOTH lines; leave them unset until the products are live.
# VITE_REVENUECAT_IOS_KEY=
# VITE_PAYWALL=on

# Linked from the plans screen (App Store guideline 3.1.2). Required with VITE_PAYWALL=on.
# Terms default to Apple's Standard EULA when unset.
# VITE_PRIVACY_URL=
# VITE_TERMS_URL=
