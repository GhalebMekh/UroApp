# UroApp build-time settings. Copy to .env.local for local development.
# Every VITE_* value is compiled into the app bundle — never put a secret here.

# Optional accounts + cloud backup (Supabase → Project Settings → API).
# Leave both unset and the app has no account UI and makes no account requests.
# Use the publishable/anon key only — NEVER the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Pro/Elite gating. Leave unset until subscriptions can actually be bought.
# VITE_PAYWALL=on
